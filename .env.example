# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./alpr_parking.db
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://alpr_user:alpr_pass@localhost:5432/alpr_parking

# ─── ALPR Engine ──────────────────────────────────────────────────────────────
MODEL_PATH=runs/detect/runs/detect/turkish_plate_run/weights/best.pt
DETECTION_CONFIDENCE=0.4
OCR_CONFIDENCE=0.3
ALPR_DEVICE=auto
OCR_DEVICE=auto
# OCR_USE_DET=false
# OCR_USE_CLS=false

# ─── Gate / Camera ────────────────────────────────────────────────────────────
GATE=ENTRANCE
CAMERA_SOURCE=0
BAR_CONFIDENCE_THRESHOLD=0.70
# Seconds between ALPR inferences per gate (2 inferences/sec is plenty for a parking barrier)
PROCESS_INTERVAL_SEC=0.5
# Maximum frame width before YOLO (reduces CPU; 0 = no resize)
PROCESS_WIDTH=960
# PyTorch and OpenCV thread caps (prevents pegging all CPU cores)
TORCH_THREADS=2
CV2_THREADS=2
DETECTION_LOG_INTERVAL_SEC=2.0
# Deprecated: FRAME_SKIP=5 — use PROCESS_INTERVAL_SEC instead

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
# camera_loop.py — refresh interval for /api/gates (seconds)
GATES_POLL_SEC=30
LOG_LEVEL=INFO
# STATUS_EVERY_SEC=3  # Deprecated — use DETECTION_LOG_INTERVAL_SEC

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Barrier / gate hardware ─────────────────────────────────────────────────
# dummy | relay | ip
BARRIER_TYPE=dummy
BARRIER_PORT=COM3
BARRIER_RELAY_CHANNEL=1
BARRIER_OPEN_DURATION_SEC=1.5
BARRIER_IP_URL=http://192.168.1.100/open
BARRIER_TIMEOUT_SEC=3
