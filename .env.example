# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./alpr_parking.db
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://alpr_user:alpr_pass@localhost:5432/alpr_parking

# ─── ALPR Engine ──────────────────────────────────────────────────────────────
MODEL_PATH=runs/detect/runs/detect/turkish_plate_run/weights/best.pt
DETECTION_CONFIDENCE=0.4
OCR_CONFIDENCE=0.3

# ─── Gate / Camera ────────────────────────────────────────────────────────────
GATE=ENTRANCE
CAMERA_SOURCE=0
BAR_CONFIDENCE_THRESHOLD=0.70
FRAME_SKIP=5

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
# camera_loop.py — refresh interval for /api/gates (seconds)
GATES_POLL_SEC=30
LOG_LEVEL=INFO
STATUS_EVERY_SEC=3

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Barrier / gate hardware ─────────────────────────────────────────────────
# dummy | relay | ip
BARRIER_TYPE=dummy
BARRIER_PORT=COM3
BARRIER_RELAY_CHANNEL=1
BARRIER_OPEN_DURATION_SEC=1.5
BARRIER_IP_URL=http://192.168.1.100/open
BARRIER_TIMEOUT_SEC=3
