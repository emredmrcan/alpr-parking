# ============================================================
#  ALPR Parking System — Configuration
#  This file is loaded automatically when the system starts.
#
#  Paths are relative to the ALPRParking\ folder.
#  Do NOT move this file — always edit it in place.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────
# Standalone (offline, recommended):
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./config/alpr_parking.db

# Network (shared PostgreSQL — uncomment and fill in if needed):
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://alpr_user:alpr_pass@192.168.1.10:5432/alpr_parking

# ── ALPR Engine ───────────────────────────────────────────────────────────
# Path to the YOLO licence-plate detection model (relative to ALPRParking\)
MODEL_PATH=models/best.pt

# Minimum confidence to accept a plate detection (0.0 – 1.0)
DETECTION_CONFIDENCE=0.4

# Minimum OCR character confidence (0.0 – 1.0)
OCR_CONFIDENCE=0.3

# ── Camera & gate settings ────────────────────────────────────────────────
# Minimum confidence before a plate is pushed to the operator UI
BAR_CONFIDENCE_THRESHOLD=0.55

# Seconds between ALPR inferences per gate (lower = more responsive, higher = lower CPU).
# 0.5 = 2 inferences/second, which is more than enough for a parking barrier.
# Raise to 1.0 or 2.0 on slow machines.
PROCESS_INTERVAL_SEC=2.0

# Maximum width (pixels) to resize frames before YOLO inference.
# Downscaling reduces CPU significantly with minimal accuracy loss.
# Set to 0 to use the camera's native resolution.
PROCESS_WIDTH=960

# Maximum number of threads PyTorch may use for CPU inference.
# Limiting this prevents alpr_engine.exe from pegging all CPU cores.
TORCH_THREADS=2

# Maximum number of threads OpenCV may use for image operations.
CV2_THREADS=2

# How often to refresh the gate list from the API (seconds)
GATES_POLL_SEC=30

# How often to print detection status to the console (seconds)
DETECTION_LOG_INTERVAL_SEC=4.0

# ── API ───────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Storage ───────────────────────────────────────────────────────────────
# Directory where uploaded / captured images are stored
UPLOAD_DIR=uploads

# ── Logging ───────────────────────────────────────────────────────────────
# INFO is recommended for production.  Use DEBUG for troubleshooting.
LOG_LEVEL=INFO

# ── Barrier / gate hardware ───────────────────────────────────────────────
# dummy  → no physical barrier (operator opens manually)
# relay  → USB relay board connected via serial port
# ip     → IP-controlled barrier (HTTP request)
BARRIER_TYPE=dummy

# Serial port for USB relay board (Windows: COM3, COM4, …)
BARRIER_PORT=COM3

# Which relay channel to trigger (1-based)
BARRIER_RELAY_CHANNEL=1

# How long to hold the relay open (seconds)
BARRIER_OPEN_DURATION_SEC=1.5

# Timeout for relay / IP barrier commands (seconds)
BARRIER_TIMEOUT_SEC=3

# URL for IP-controlled barrier (only used when BARRIER_TYPE=ip)
BARRIER_IP_URL=http://192.168.1.100/open
